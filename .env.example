# Application
APP_NAME=Bulk Certificate Generator
LOG_LEVEL=INFO

# Relational database. SQLite by default; any SQLAlchemy URL works
# (e.g. postgresql+psycopg://user:pass@localhost:5432/certificates).
DATABASE_URL=sqlite:///./data/certificates.db

# Where generated PDFs are written.
STORAGE_DIR=./storage

# Background generation worker pool size.
MAX_WORKERS=4

# Reject jobs larger than this.
MAX_RECIPIENTS_PER_JOB=5000

# "thread" = background thread pool (default), "inline" = run during request
# (handy for tests and small deployments).
GENERATION_MODE=thread

# Automatic retries for transient generation errors (validation failures are
# never retried) plus the backoff between attempts, in seconds.
MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=0.2

# Artificial per-recipient delay in milliseconds. Keep 0 in production; useful
# for demos and for exercising cancellation.
GENERATION_DELAY_MS=0

# Re-dispatch jobs left PENDING/PROCESSING when the app starts (crash recovery).
RECOVER_INCOMPLETE_JOBS=true

# Base URL used to build the verification link embedded in PDFs.
PUBLIC_BASE_URL=http://localhost:8000
